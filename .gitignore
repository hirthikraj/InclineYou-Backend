target/
*.class
*.jar
*.war
*.ear
*.log
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ── Spring Boot ───────────────────────────────────────────────────────────────
backend/src/main/resources/application-local.yml

# ── Node / npm ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Expo / React Native ───────────────────────────────────────────────────────
.expo/
dist/
android/build/
android/.gradle/
ios/build/
ios/Pods/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# ── Secrets / env ─────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
# IntelliJ's compile output. It once shipped a stale copy of application.yml and
# V1__init_schema.sql into git; nothing builds from here.
out/
*.iml
*.iws
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / tool droppings ───────────────────────────────────────────────────
# The design sets are hand-edited HTML+CSS with a generator beside them, so they
# accumulate .bak copies and __pycache__; none of it is the source of truth.
*.bak
*.bak[0-9]*
*.bak-*
__pycache__/
*.pyc
# macOS zip artefacts from the design hand-offs.
__MACOSX/
