# InclineYou — environment
#
#   cp .env.example .env
#
# `docker compose` reads this file from this directory automatically. The
# backend does not — Spring Boot has no .env support — so to run the API with
# these values, export them first:
#
#   set -a; source .env; set +a; cd backend && ./mvnw spring-boot:run
#
# Every value below is also the default compiled into `application.yml`, so a
# plain `./mvnw spring-boot:run` with no .env at all still works against the
# compose database. This file exists to make the two database identities
# visible, and to be the checklist for a real deployment.
#
# Committed as .env.example only. `.env` is gitignored — keep it that way.

# ── The database, and its TWO identities ─────────────────────────────────────
#
# This is the one piece of configuration where getting it wrong is silent.
# Postgres exempts a table's OWNER from that table's row-level security
# policies, so the same connection string with the wrong username turns all 45
# policies off while every log line looks identical.
#
#   inclineyou_app  the request path. Owns nothing, so the policies apply to it.
#   inclineyou      the owner. Flyway, the seed scripts and the test suite, and
#             nothing else — a migration backfilling a column across every
#             workspace must not be filtered down to the caller's own.
#
# Both connect to the same database; only the login differs.
#
# ENCRYPTION IN TRANSIT: add `?sslmode=verify-full&sslrootcert=<ca.pem>` to this
# URL on any deployment where the database is not on localhost. libpq's default
# is `sslmode=prefer`, which uses TLS if offered and falls back to PLAINTEXT
# without complaining if it is not — so a URL with no sslmode looks identical
# whether or not every row is crossing the network in clear text.
#
#   require      encrypts, does NOT check the certificate. Stops a passive
#                listener; does not stop an active man in the middle.
#   verify-full  encrypts AND authenticates the server. The one to use.
#
# The app asks Postgres at boot which it got (`pg_stat_ssl`) and logs
# "Database transport: ENCRYPTED" or a warning — see TransportSecurityCheck.
# That check can prove the bytes are encrypted; it cannot see which sslmode was
# asked for, so verify-full is on you.
DATABASE_URL=jdbc:postgresql://localhost:5432/inclineyoudb

# The request path. This is the pair the application pool logs in with, and
# APP_DB_PASSWORD is also the password set on the role itself — one secret, one
# variable, deliberately, because two names for one password is how a deployment
# sets one, misses the other, and cannot boot.
#
# Changing it here is enough: a startup callback re-applies it to the role on
# every boot, as the migration user. Leaving it UNSET is not the same as setting
# it to the default below — an unset variable leaves the role's password alone,
# so a deployment that forgot it fails to start rather than falling back to a
# password that is published in this file.
APP_DB_USERNAME=inclineyou_app
APP_DB_PASSWORD=inclineyou_app_dev

# Flyway and the seeds. Owner privileges: DDL, the backfills, and creating the
# app role above. Never used to serve a request.
MIGRATION_DB_USERNAME=inclineyou
MIGRATION_DB_PASSWORD=inclineyou_dev

# Docker Compose's Postgres is initialised as the owner, so these mirror the
# MIGRATION pair. Changing them only has an effect on a FRESH volume — initdb
# runs once, so editing a password here after the first `up` changes nothing.
# `inclineyou_app` is not created here; V42 creates it, as the owner, on migrate.
POSTGRES_USER=inclineyou
POSTGRES_PASSWORD=inclineyou_dev
POSTGRES_DB=inclineyoudb

# ── Redis ────────────────────────────────────────────────────────────────────
# The kill switch. Off — or unreachable — and OTP state falls back to Postgres
# and rate limiting to in-process buckets; nobody is locked out because a cache
# is down. Note that compose runs Redis with `--appendonly yes` on purpose: the
# OTP lock is an abuse control, and without AOF "three attempts" becomes "three
# attempts per deploy".
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# TLS to Redis. False for the compose instance on the loopback; true for any
# managed Redis reached over a network. The OTP lock and the rate-limit counters
# are abuse controls, and an attacker who can rewrite them in flight has turned
# "three attempts" into unlimited.
REDIS_SSL=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Rotating it signs every phone out, because a
# mobile token is a self-contained JWT with a seven-day life. Making that
# rotatable without ejecting everybody is M1 in backend/IDENTITY.md.
JWT_SECRET=dev-only-secret-change-before-production-32chars

# Write the OTP to the application log. MUST BE FALSE IN PRODUCTION — a log is
# storage, shipped to an aggregator and retained, and a code sitting in one is a
# credential at rest in the place nobody counts as a store.
#
# The app will not start with this true against an encrypted database
# connection: those two facts together are a real deployment printing sign-in
# codes, which has no legitimate reading. If turning it off breaks sign-in with
# "no SMS provider is wired", that is the true state of the system — wire the
# provider, do not turn the log back on.
OTP_DEV_CODES_IN_LOG=true

# ── Transport ────────────────────────────────────────────────────────────────
# Redirect any plaintext request. Set this and FORWARD_HEADERS together or not
# at all: behind a proxy that terminates TLS every request reaches the container
# as HTTP, and only X-Forwarded-Proto says otherwise — so REQUIRE_HTTPS=true
# with FORWARD_HEADERS=none is an infinite redirect, not a hardened API.
REQUIRE_HTTPS=false

# ── Ports (host-side, for docker compose) ────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# ── Kill switches ────────────────────────────────────────────────────────────
# The ceiling on every endpoint. TRUE in production and in anything started as a
# jar; `./mvnw spring-boot:run` activates the `dev` profile, whose default is
# FALSE — on a laptop every unsigned-in caller is `ip:127.0.0.1`, so Expo, the
# Next dev server and a curl loop share one 120/60s bucket and a hot reload
# spends it. This variable still wins in both directions: set it to true to
# exercise the limiter locally.
RATE_LIMIT_ENABLED=true
SEED_EXERCISES=true
TEAM_ENABLED=true
# Blank disables push entirely; otherwise the FCM service-account JSON.
FCM_CREDENTIALS=
# Set to `framework` behind a proxy that terminates TLS (Railway does), or
# every trainer shares one rate-limit bucket keyed on the proxy's address.
FORWARD_HEADERS=none
