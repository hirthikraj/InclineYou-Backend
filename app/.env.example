# Copy to .env (gitignored) and adjust. Only EXPO_PUBLIC_* vars reach the app
# bundle — never put secrets here, they ship in plain text inside the APK.

# Where the Spring Boot backend lives.
#   Android emulator          → http://10.0.2.2:8080   (the default if unset)
#   Real phone on the same wifi → http://<your-machine-LAN-IP>:8080
#   Staging / production      → set per profile in eas.json instead
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
